## ================================================================ V5 resources
#elseif($test == "resInclude")
  <p>If you see INCLUDE-OK below, the include directive resolves widget resources:</p>
  <pre>#include("resources/spike.txt")</pre>
#elseif($test == "resParse")
  <p>If you see PARSE-OK below, the parse directive resolves widget resources:</p>
  <pre>#parse("resources/spike.vm")</pre>
#elseif($test == "resUrl")
  #set($projLoc = "")
  #set($projLoc = $projectService.getProject($projectId).getLocation().getLocationPath())
  <p>The browser tries to fetch <code>resources/spike.js</code> from candidate URLs. Report which ones answer 200.</p>
  <div class="bws-res" data-projloc="$!esc.html($projLoc)">running...</div>
  <script>
  (function () {
    var boxes = document.querySelectorAll('.bws-res');
    var box = boxes[boxes.length - 1];
    var loc = (box.getAttribute('data-projloc') || '').split('/').filter(Boolean).join('/');
    var rel = '.polarion/pages/widgets/bwSpike/resources/spike.js';
    var urls = ['/repo/' + rel, '/polarion/repo/' + rel];
    if (loc) { urls.push('/repo/' + loc + '/' + rel); urls.push('/polarion/repo/' + loc + '/' + rel); }
    box.innerHTML = '';
    urls.forEach(function (u) {
      var line = document.createElement('div');
      line.textContent = u + ' ... ';
      box.appendChild(line);
      fetch(u, { credentials: 'same-origin' })
        .then(function (r) { line.textContent = u + ' -> HTTP ' + r.status; })
        .catch(function (e) { line.textContent = u + ' -> error ' + e; });
    });
  })();
  </script>

## ================================================================ V6 JavaScript
#elseif($test == "js")
  <div class="bws-js" style="padding:4px;border:1px dashed rgb(153,153,153);">JS NOT executed (inline scripts blocked?)</div>
  <script>
  (function () {
    var boxes = document.querySelectorAll('.bws-js');
    var box = boxes[boxes.length - 1];
    var out = [];
    function log(ok, msg) { out.push('<div class="' + (ok ? 'ok' : 'ko') + '">' + (ok ? 'OK ' : 'FAIL ') + msg + '</div>'); box.innerHTML = out.join(''); }
    log(true, 'inline script executed; userAgent = ' + navigator.userAgent.replace(/</g, '&lt;'));
    var ns = 'http://www.w3.org/2000/svg';
    var svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('xmlns', ns); svg.setAttribute('width', '240'); svg.setAttribute('height', '80');
    svg.innerHTML = '<rect x="5" y="20" width="80" height="40" rx="6" fill="rgb(219,233,255)" stroke="rgb(51,103,214)"/>' +
      '<text x="45" y="45" text-anchor="middle" font-size="12" font-family="Arial">Doc A</text>' +
      '<line x1="85" y1="40" x2="150" y2="40" stroke="rgb(198,40,40)" stroke-dasharray="5,3" stroke-width="2"/>' +
      '<rect x="150" y="20" width="80" height="40" rx="6" fill="rgb(255,232,214)" stroke="rgb(194,94,0)"/>' +
      '<text x="190" y="45" text-anchor="middle" font-size="12" font-family="Arial">Doc B</text>';
    var holder = document.createElement('div');
    holder.appendChild(svg);
    box.parentNode.insertBefore(holder, box.nextSibling);
    log(!!svg.getBBox, 'inline SVG rendered');
    try {
      var xml = new XMLSerializer().serializeToString(svg);
      var svgUrl = URL.createObjectURL(new Blob([xml], { type: 'image/svg+xml' }));
      var a1 = document.createElement('a'); a1.href = svgUrl; a1.download = 'bw-spike.svg'; a1.textContent = 'Download SVG';
      holder.appendChild(a1);
      log(true, 'SVG serialised, blob URL created');
      var img = new Image();
      img.onload = function () {
        try {
          var c = document.createElement('canvas'); c.width = 480; c.height = 160;
          var ctx = c.getContext('2d'); ctx.fillStyle = 'rgb(255,255,255)'; ctx.fillRect(0, 0, 480, 160);
          ctx.drawImage(img, 0, 0, 480, 160);
          var png = c.toDataURL('image/png');
          var a2 = document.createElement('a'); a2.href = png; a2.download = 'bw-spike.png'; a2.textContent = 'Download PNG';
          a2.style.marginLeft = '12px'; holder.appendChild(a2);
          log(true, 'PNG generated via canvas (' + png.length + ' chars)');
        } catch (e) { log(false, 'PNG canvas export: ' + e); }
      };
      img.onerror = function () { log(false, 'SVG blob could not be loaded as image (CSP blocks blob:?)'); };
      img.src = svgUrl;
    } catch (e) { log(false, 'SVG export: ' + e); }
    log(typeof fetch === 'function', 'fetch API available');
  })();
  </script>

