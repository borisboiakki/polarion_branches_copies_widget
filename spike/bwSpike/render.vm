      #set($roleSql = "${roleSql},")
    #end
    #set($roleSql = "${roleSql}'${rt}'")
  #end
#end

## Common SQL: links with a configured role whose two ends are contained in two different documents
## ws/ms = link source item and its document, wt/mt = link target item and its document
#set($linkBase = "FROM struct_workitem_linkedworkitems l INNER JOIN workitem ws ON ws.c_uri = l.fk_uri_p_workitem INNER JOIN workitem wt ON wt.c_uri = l.fk_uri_workitem INNER JOIN module ms ON ms.c_uri = ws.fk_uri_module INNER JOIN module mt ON mt.c_uri = wt.fk_uri_module INNER JOIN project p ON p.c_uri = ws.fk_uri_project WHERE p.c_id = '${projectId}' AND l.c_role IN (${roleSql}) AND ms.c_uri <> mt.c_uri")
#set($docSql = "SELECT m.c_uri FROM module m INNER JOIN project p ON p.c_uri = m.fk_uri_project WHERE p.c_id = '${projectId}'")

## Document key used to group: space/document-name
#macro(bwsDocKey $mod)#set($bwsKey = "")#if($mod)#set($bwsKey = "$!mod.getModuleFolder()/$!mod.getId()")#end#end

