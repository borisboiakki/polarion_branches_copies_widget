## Document key used everywhere: "project/space/name" (bwKeyProject = project of the document).
## Referenced objects (document of a link, "branched from" source) can be unresolvable (deleted, no access).
## Any access other than isUnresolvable() then throws, so they are only used when isUnresolvable() is false.
#macro(bwKey $bwMod)
  #set($bwKeyOut = "")
  #set($bwUr = "unknown")
  #if($bwMod)
    #set($bwUr = $bwMod.isUnresolvable())
  #end
  #set($bwKeyProject = "")
  #if("$bwUr" == "false")
    #set($bwP = "")
    #set($bwP = $bwMod.getProjectId())
    #if("$bwP" == "")
      #set($bwP = $projectId)
    #end
    #set($bwF = "")
    #set($bwF = $bwMod.getModuleFolder())
    #set($bwN = "")
    #set($bwN = $bwMod.getId())
    #if("$bwN" != "")
      #set($bwKeyOut = "${bwP}/${bwF}/${bwN}")
      #set($bwKeyProject = "$bwP")
    #end
  #end
#end

## Document label for tables and lists: "space / name", prefixed with the project when several projects are in scope,
## "(HEAD)" added for a document of a collection without a pinned revision (documents.vm).
#macro(bwDocLabel $bwD)
  #set($bwLs = $bwD.get("space"))
  #set($bwLn = $bwD.get("id"))
  #set($bwDocLabelOut = "${bwLs} / ${bwLn}")
  #if($multiProject)
    #set($bwLp = $bwD.get("project"))
    #set($bwDocLabelOut = "${bwLp} / ${bwDocLabelOut}")
  #end
  #if($bwD.get("rev") == "HEAD")
    #set($bwDocLabelOut = "${bwDocLabelOut} (HEAD)")
  #end
#end

