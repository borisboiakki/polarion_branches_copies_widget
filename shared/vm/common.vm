## 2512) and projects (@project, id() expected to be the project id: not yet verified on 2512).
## Identifiers only, as they go into SQL.
#macro(bwOptionIds $bwVals $bwOut)
  #if($bwVals)
    #foreach($bwV in $bwVals)
      #set($bwRid = "$bwV")
