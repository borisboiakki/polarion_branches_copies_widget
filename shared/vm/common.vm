## Shared snippet common.vm (shared/vm), inlined by tools/build-widget.py at "## BW_SHARED common.vm".
## Lists, projects in scope, output mode and the bwKey / bwDocLabel macros. Needs params.vm.
## Option ids from the values() of an enumeration multi-selector: link roles (workitem-link-role, verified on 2512,
## docCoverage spike C2: each value is a ProxyEnumOption, id() = role id), work item types (workitem-type, verified on
## 2512) and projects (@project, id() expected to be the project id: not yet verified on 2512).
## Identifiers only, as they go into SQL.
#macro(bwOptionIds $bwVals $bwOut)
  #if($bwVals)
    #foreach($bwV in $bwVals)
      #set($bwRid = "$bwV")
      #set($bwRid = $bwV.id())
      #set($bwRidS = "$bwRid")
      #if($bwRidS.matches("[A-Za-z0-9_.-]+") && !$bwOut.contains($bwRidS))
        #set($void = $bwOut.add($bwRidS))
      #end
    #end
  #end
#end

#set($excludedTypes = [])
#bwOptionIds($excludedTypeVals $excludedTypes)

## Space names may contain blanks; they are compared in Velocity only, never put into SQL.
#set($spaceFilter = [])
#foreach($bwPart in $spacesStr.split(","))
  #set($bwT = $bwPart.trim())
  #if($bwT != "")
    #set($void = $spaceFilter.add($bwT))
  #end
#end

#set($typeSql = "")
#foreach($t in $excludedTypes)
  #if($typeSql != "")
    #set($typeSql = "${typeSql},")
  #end
  #set($typeSql = "${typeSql}'${t}'")
#end

